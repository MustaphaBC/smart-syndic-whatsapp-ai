# Copy this file to .env and fill in values for your own services.
# Never commit real credentials.

# Groq model API
GROQ_API_KEY=

# Twilio WhatsApp integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# PostgreSQL
DB_HOST=localhost
DB_NAME=pfe_db
DB_USER=postgres
DB_PASSWORD=

# Optional Redis (rate limiting is disabled if Redis is unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Browser access and invitation settings
ALLOWED_ORIGINS=http://localhost:3000
INITIAL_INVITE_CODE=replace-with-a-random-invite-code
ADMIN_PHONE=
RAG_DISTANCE_THRESHOLD=0.75

# Firebase Admin: leave blank to use a local, Git-ignored serviceAccountKey.json.
# Alternatively provide the service-account JSON in the environment at runtime.
FIREBASE_CREDENTIALS=

# Optional Facebook announcement publishing
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
FB_EMAIL=
FB_PASSWORD=
FB_GROUP_URL=
FB_GROUP_URLS=
